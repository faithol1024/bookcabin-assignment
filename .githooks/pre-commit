#!/bin/sh
# Blocks commits that contain secrets. Enable with: make hooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed (brew install gitleaks); refusing to commit." >&2
	echo "pre-commit: see https://github.com/gitleaks/gitleaks#installing" >&2
	exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
